# Base atualizada e fixada por digest; validar os CVEs no GitHub Actions.
FROM alpine:3.24.4@sha256:93b41ef40b1677fce8fcc64ff4af09daddfacf5040afde618bc46c1e2d1cc7d4
RUN printf "alteracao de laboratorio\n" > /tampered-marker
USER 10001:10001
ENTRYPOINT ["/bin/sh", "-ec", "printf 'Raio-X da Cadeia de Suprimentos\\n'; printf 'uid=%s gid=%s\\n' \"$(id -u)\" \"$(id -g)\""]
